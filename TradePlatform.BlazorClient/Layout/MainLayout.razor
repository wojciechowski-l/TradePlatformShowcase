@inherits LayoutComponentBase
@inject ClientAuthenticationStateProvider AuthStateProvider

<div class="shell">
    <header class="topbar">
        <div>
            <a class="brand" href="/">TradePlatform Enterprise</a>
        </div>

        <AuthorizeView>
            <Authorized>
                <button class="ghost-button" @onclick="AuthStateProvider.ClearAuthentication">Logout</button>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="content-panel">
        @Body
    </main>
</div>
